// Cloudflare Worker die alleen het voortgangsdashboard serveert (M1, PH-DEC-006).
// Build command in Workers Builds: node dashboard/check-status.mjs && cp project-status.json dashboard/
// Deploy command: npx wrangler deploy
{
  "name": "project-hub",
  "compatibility_date": "2026-10-13",
  // Publiek adres: https://project-hub.lucas-galle1.workers.dev
  "workers_dev": true,
  // Nodig voor preview-builds van andere branches (npx wrangler preview)
  "previews": {},
  "assets": {
    "directory": "./dashboard"
  }
}
